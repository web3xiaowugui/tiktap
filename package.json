{
  "name": "tiktap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @tiktap/web --filter @tiktap/server run dev",
    "dev:web": "pnpm --filter @tiktap/web dev",
    "dev:server": "pnpm --filter @tiktap/server dev",
    "build": "pnpm --filter @tiktap/web build",
    "preview": "pnpm --filter @tiktap/web preview",
    "typecheck": "pnpm -r --if-present run typecheck",
    "db:reset": "node -e \"require('node:fs').rmSync('data', { recursive: true, force: true })\"",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts"
  }
}
