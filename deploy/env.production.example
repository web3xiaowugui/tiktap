# 生产环境配置（部署到 VPS 用，独立于本地 .env）
# 注意：本文件已被 .gitignore 排除，不要提交。
# 部署时会被打包成服务器上的 /srv/tiktap/.env

APP_ENVS=testnet
PORT=8787
DB_PATH=./data/tiktap-auto.db

# 站点公网地址（域名确定后填 https://xxx）
PUBLIC_BASE_URL=
WEB_BASE_URL=

# 结算 / 自动领奖
AUTO_SETTLE=1
AUTO_CLAIM=1

# X Layer 测试网（链上地址与本地一致，密钥沿用）
TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
TESTNET_CHAIN_ID=1952
TESTNET_WALLET_ENC_KEY=
TESTNET_OPERATOR_PKEY=
TESTNET_POOL_MARKET_ADDRESS=
TESTNET_TEST_TOKEN_ADDRESS=
TESTNET_OKB_TOKEN_ADDRESS=
TESTNET_BEM_TOKEN_ADDRESS=
TESTNET_GAS_TOPUP_WEI=500000000000000

# 新的 X 应用（生产专用，不用本地那套）
# 回调地址：https://<域名>/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# 管理密钥：手动调用 /api/settle 时必须带 X-Admin-Key 头
ADMIN_KEY=

# 不使用主网
MAINNET_RPC_URL=https://rpc.xlayer.tech
MAINNET_CHAIN_ID=196

# 演示登录开关（默认关闭，只允许 X 授权账号；本地开发或评审 ?demo=1 时设 ALLOW_DEMO_LOGIN=1）
# ALLOW_DEMO_LOGIN=1

# 临时停用的下注代币（逗号分隔，留空=全部启用）
# DISABLED_BET_TOKENS=OKB,BEM
