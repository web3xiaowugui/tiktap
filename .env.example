# 链
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=195

# 服务
PORT=8787

# 本地库
DB_PATH=./data/tiktap.db

# 用户私钥加密密钥（64 位 hex，生成：openssl rand -hex 32）
WALLET_ENC_KEY=

# 平台 operator 私钥：只用于 settle / setAllowed / setMarket（不要用用户的钱包）
OPERATOR_PKEY=

# 部署后的合约地址（pnpm contracts:deploy 会打印出来）
POOL_MARKET_ADDRESS=
TEST_TOKEN_ADDRESS=
OKB_TOKEN_ADDRESS=
BEM_TOKEN_ADDRESS=

# 建号时给新地址打多少原生币当 gas（本地演示用，主网留空或 0）
GAS_TOPUP_WEI=50000000000000000

# 自动结算（1=每 3 秒检查并结算上一轮；本地用 anvil_mine 快进时设为 0）
AUTO_SETTLE=1
# X（Twitter）账号登录：在 https://developer.x.com 建 OAuth 2.0 应用，
# 回调地址填 PUBLIC_BASE_URL + /api/auth/x/callback（本地就是 http://127.0.0.1:8787/api/auth/x/callback）
X_CLIENT_ID=
X_CLIENT_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8787
# 授权完成后把浏览器送回哪个前端地址
WEB_BASE_URL=http://127.0.0.1:5173
# 结算后自动领奖（后端用用户托管私钥代领，用户不用点领取；设 0 关闭）
AUTO_CLAIM=1
