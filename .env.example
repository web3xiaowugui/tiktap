# 单后端、单库；可选环境由 APP_ENVS 配置，请求参数 env 决定当前环境（支持 dev/testnet/mainnet）
# 链（dev / 本地 Anvil）
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=195

# 服务
PORT=8787

# 启用的环境（逗号分隔，顺序即前端下拉顺序）
# 本地开发用 dev,testnet；线上只开测试网+主网：APP_ENVS=testnet,mainnet
APP_ENVS=dev,testnet

# 本地库
DB_PATH=./data/tiktap.db

# 用户私钥加密密钥（64 位 hex，生成：openssl rand -hex 32）
WALLET_ENC_KEY=

# 平台 operator 私钥：只用于 settle / setAllowed / setMarket（不要用用户的钱包）
OPERATOR_PKEY=

# 部署后的合约地址（pnpm contracts:deploy 会打印出来）
POOL_MARKET_ADDRESS=
TEST_TOKEN_ADDRESS=
# OKB 用 WOKB（测试网自部署，主网用官方 WOKB）
OKB_TOKEN_ADDRESS=
BEM_TOKEN_ADDRESS=

# 建号时给新地址打多少原生币当 gas（本地演示用，主网留空或 0）
GAS_TOPUP_WEI=50000000000000000

# 自动结算（1=每 3 秒检查并结算上一轮；本地用 anvil_mine 快进时设为 0）
AUTO_SETTLE=1

# X Layer Testnet：同一个后端、同一个库，请求带 ?env=testnet
TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
TESTNET_CHAIN_ID=1952
TESTNET_WALLET_ENC_KEY=
TESTNET_OPERATOR_PKEY=
TESTNET_POOL_MARKET_ADDRESS=
TESTNET_TEST_TOKEN_ADDRESS=
TESTNET_OKB_TOKEN_ADDRESS=
TESTNET_BEM_TOKEN_ADDRESS=
TESTNET_GAS_TOPUP_WEI=500000000000000

# X Layer 主网：同一套逻辑，prefix 换成 MAINNET_（chainId 196）
# 只在 APP_ENVS 里启用 mainnet 时才会读取；没配 market 时链上写操作自动跳过
MAINNET_RPC_URL=https://rpc.xlayer.tech
MAINNET_CHAIN_ID=196
MAINNET_WALLET_ENC_KEY=
MAINNET_OPERATOR_PKEY=
MAINNET_POOL_MARKET_ADDRESS=
MAINNET_TEST_TOKEN_ADDRESS=
MAINNET_OKB_TOKEN_ADDRESS=
MAINNET_BEM_TOKEN_ADDRESS=
MAINNET_GAS_TOPUP_WEI=0

# X（Twitter）账号登录：在 https://developer.x.com 建 OAuth 2.0 应用
# 回调地址只登记一个：http://127.0.0.1:8787/api/auth/x/callback
# 环境由前端当前选择决定，不放进回调 URL。
X_CLIENT_ID=
X_CLIENT_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:8787
# 授权完成后把浏览器送回哪个前端地址
WEB_BASE_URL=http://127.0.0.1:5173
# 结算后自动领奖（后端用用户托管私钥代领，用户不用点领取；设 0 关闭）
AUTO_CLAIM=1
